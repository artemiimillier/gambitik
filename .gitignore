# dependencies & build output
node_modules/
dist/
*.tsbuildinfo
.vite/

# runtime data (SQLite, PGN/markdown journals, student profile, logs) — never committed
data/

# secrets
.env
.env.*
!.env.example

# Stockfish files are copied from node_modules by `pnpm engine:copy`
apps/web/public/engine/*
!apps/web/public/engine/.gitkeep

# raw downloads for the puzzle / openings import
*.csv.zst
*.pgn.zst

# test artefacts
coverage/
playwright-report/
test-results/

# OS / editors
.DS_Store
*.log
.idea/
.vscode/

# local Claude Code settings (personal permissions, preview configs)
.claude/

# stray databases / rotated logs outside data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.log.*

# local voice listening copies (demo game, splice tests): heavy, regenerated by the tools, never committed
docs/voice-samples/

# «Дозапись голоса»: the recorded overlay lives outside every checkout (~/Library/Application Support/Gambitik/
# voice-overlay; the tools and the server refuse one inside a repository) — a copy dropped in here is never committed
/voice-overlay/

# teaching report: report.md/json are kept; the raw games and all 50 transcripts are regenerated by `pnpm teach:report`
docs/teaching/report/games.jsonl.gz
docs/teaching/report/transcripts/

# deploy kit: the operator's own target (ssh alias, host name, paths); deploy.env.example is the template
deploy/docker-ssh/deploy.env

# the tools ledger of paid recording jobs: local spending history (job ids, result URLs), never committed
tools/voice-clips/ledger.*.jsonl
