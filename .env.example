# Copy to `.env` (never committed). Everything works without any key:
# template phrases + the recorded voice («Записи») are the baseline.
# Keys stay on the local server: they are never logged, never sent to the browser and never
# handed to the codex child process.

# ───────────── Runtime AI (master switch) ─────────────
# 0 (default) = NO generative AI in the child's game (docs/TEACHING.md §4.4): Stockfish + our code +
# pre-written phrases only. The text chain is the template, codex is never started, /api/voice/live and
# /api/voice/session answer 503, the browser uses the recorded voice. It wins over LLM_PROVIDER,
# VOICE_PREFERRED, CODEX_BIN and the keys below (a key may stay here: Settings still shows it, nothing uses it).
# 1 = the live OpenAI voice, the LLM strategist / re-plans / reviews and codex may be used.
GAMBIT_RUNTIME_AI=0

# ───────────── Voice (OpenAI only) ─────────────
# OpenAI API key — enables the live voice coach (and the last-resort API fallback for game reviews).
# A ChatGPT subscription does NOT cover voice; this must be an API-platform key.
OPENAI_API_KEY=

# Which voice the app tries first: clips | live | realtime (live / realtime need GAMBIT_RUNTIME_AI=1;
# with runtime AI off the server always says clips)
#   clips    = the pre-recorded voice («Записи»): free, no microphone.
#   live     = Live API, full duplex (listens and speaks at the same time). $0.05 per connected
#              minute INCLUDING silence; every session start bills 15 s. The app closes the session
#              after 90 s of quiet outside a game, after 2 min without the child's moves or words inside
#              a game, 15 s after the tab went to the background, and at once when the page is closed;
#              it reopens it on the next need. Daily limit: 60 min of paid voice per day by default
#              (parent settings: 30 / 60 / 90 / 120 min or no limit) — counted and enforced in the browser,
#              the server keeps no spending cap of its own.
#   realtime = Realtime API, turn-based with barge-in. Billed per token, silence is free.
# With GAMBIT_RUNTIME_AI=1, live is the measured choice (real test sessions: connects in 2.3–4.3 s,
# answers 1.3–1.9 s after the child stops talking,
# Russian only, yields when the child talks, engine-grounded answers through client delegation).
VOICE_PREFERRED=clips

# Live API (full duplex)
VOICE_LIVE_MODEL=gpt-live-1
VOICE_LIVE_VOICE=marin

# Realtime API (alternative / fallback)
VOICE_MODEL=gpt-realtime-2.1
VOICE_NAME=marin
# VOICE_TRANSCRIBE_MODEL=gpt-live-transcribe
# VOICE_SECRET_TTL_S=120

# ───────────── Text (game reviews) ─────────────
# auto | codex | openrouter | openai-api | template (anything but template needs GAMBIT_RUNTIME_AI=1)
# auto = Codex CLI (ChatGPT subscription) -> OpenRouter -> OpenAI API -> built-in templates.
# A provider that hits its usage limit / runs out of credits is skipped until it recovers.
LLM_PROVIDER=template
CODEX_MODEL=gpt-5.6-luna
# CODEX_BIN=/opt/homebrew/bin/codex      # absolute path; `off` disables the codex provider

# OpenRouter key — TEXT ONLY (reviews). Tip: create a separate key with a monthly credit limit.
OPENROUTER_API_KEY=
OPENROUTER_REVIEW_MODEL=openai/gpt-5.6-terra
# comma separated, tried by OpenRouter when the main model is unavailable; `none` = no fallback
OPENROUTER_FALLBACK_MODELS=openai/gpt-5.6-luna

# OPENAI_TEXT_MODEL=gpt-5.6-luna
# LLM_TIMEOUT_MS=90000

# ───────────── «Учитель»: the smart strategist (GAMBIT_RUNTIME_AI=1 only) ─────────────
# Without runtime AI the strategy is the free choice from the library (still a different one every
# game) and the web asks for no re-plans.
# Picks this game's strategy from the curated library (a different one every game) and re-plans
# when the opponent leaves the plan. It may only CHOOSE among what the code offers (library ids,
# engine-checked moves); the server validates every answer. Same providers and LLM_PROVIDER as the
# reviews, but a stronger model and no reasoning pass (measured: Sol ~7 s via codex,
# ~5-6 s via OpenRouter). Your ChatGPT subscription (codex) is asked FIRST for both:
#   strategy (the game's first line waits for it, 8 s): codex (up to STRATEGY_CODEX_MS) -> OpenRouter
#            -> OpenAI API -> template. A codex that is missing, logged out or over its weekly limit is
#            skipped at once; one that was too slow is skipped for the next games for a while.
#   re-plan (background, 15 s): codex -> OpenRouter -> OpenAI API -> template.
# OpenRouter Sol costs ~0.1-0.5 cent per call (a few cents per game at most) and is only used when
# codex cannot answer. Automated test runs always get the free choice.
CODEX_STRATEGY_MODEL=gpt-5.6-sol
OPENROUTER_STRATEGY_MODEL=openai/gpt-5.6-sol
# OPENAI_STRATEGY_MODEL=gpt-5.6-sol
# STRATEGY_CODEX_FIRST=0 = the API-first order for the strategy (OpenRouter -> OpenAI API -> codex);
# STRATEGY_CODEX_MS = how long the strategy waits for codex (3000-7800 ms)
# STRATEGY_CODEX_FIRST=1
# STRATEGY_CODEX_MS=7500
# A second stack on other ports (e2e / smoke tests while your own server holds 8787):
# GAMBIT_API_PORT=8788
# GAMBIT_WEB_PORT=5174

# ───────────── Behind a TLS proxy (the server instance, deploy/docker-ssh — not for the Mac) ─────────────
# Unset = the Mac: listen on 127.0.0.1, trust only 127.0.0.1 / localhost. The container image sets these itself.
# GAMBIT_BIND_HOST: 0.0.0.0 or another IP literal (a host name is refused and 127.0.0.1 kept).
# GAMBIT_PUBLIC_HOSTS: up to 5 lowercase host names (optional :port), trusted as the Host and as the https:// Origin;
# the proxy must pass the browser's Host on. GAMBIT_PUBLIC_HTTP=1 also trusts http://<name> (a proxy without TLS).
# GAMBIT_BUILD_SHA: the commit an image was built from (reported by /api/health when there is no .git).
# GAMBIT_BIND_HOST=0.0.0.0
# GAMBIT_PUBLIC_HOSTS=kids.example.com

# ───────────── Privacy ─────────────
# Review prompts contain moves + engine judgements + the pseudonym — and NOT what the child said
# (only how many times the child spoke). Set to 1 to let the API review providers (OpenRouter /
# OpenAI — never codex) also see redacted, clipped child utterances.
REVIEW_INCLUDE_CHILD_SPEECH=0

# DATA_DIR=data

# ───────────── «Дозапись голоса»: recording missing lesson phrases (PAID, off by default) ─────────────
# When a pre-written lesson phrase has no recording yet, the server records it ONCE with your Higgsfield account
# (voice Giselle, text2speech_v2) and reuses it forever. The words stay the pre-written ones — only the voice is
# made. The first time the phrase is shown without voice; from the next time on it is spoken.
# Costs: ≈ 0.15–0.75 credits per recorded utterance; spend is read from the overlay ledger (a job whose outcome is not
# known yet counts in full). The Higgsfield balance itself is never read.
# Nothing is recorded unless ALL of these hold: GAMBIT_CLIP_GEN=1, CLIP_GEN_DATA_DIR = this server's real DATA_DIR,
# DATA_DIR is not a temp folder, a valid VOICE_OVERLAY_DIR, CLIP_GEN_BUDGET > 0, the Higgsfield CLI found and signed in
# (`higgsfield auth login`), ffmpeg + whisper-cli + the whisper model installed, and the parent switched it on in
# Settings («Дозапись новых фраз», behind the parental lock). Automated test runs never record.
GAMBIT_CLIP_GEN=0
# Credits over the whole life of the overlay ledger (on-demand recordings only; your own prefetch runs have their own
# --budget). Required: without it nothing is recorded.
# CLIP_GEN_BUDGET=60
# The most credits per local day (default 3, 0.15–30; 0 = the minimum, 0.15). The parent picks a lower daily cap in Settings.
# CLIP_GEN_DAILY_MAX=15
# The absolute path of THIS server's DATA_DIR — a copied .env in another checkout or a test instance never spends.
# CLIP_GEN_DATA_DIR=/Users/<you>/Chess/data
# Absolute path of the Higgsfield CLI, or `off`. Unset: PATH, ~/.local/bin, /opt/homebrew/bin, /usr/local/bin.
# HIGGSFIELD_BIN=/Users/<you>/.local/bin/higgsfield
# The ONE folder of recorded phrases on this Mac (the takes, the overlay ledger, the lock), outside every git checkout,
# DATA_DIR and the web build; `off` = none. Its phrases are played even when recording is off or the budget is spent.
# The voice tools (`pnpm voice:*`) read this line from this file too (and DATA_DIR, to keep the overlay out of the
# child's data — no other line, never a key), so a manual `voice:generate` takes the same machine-wide lock and
# sees the server's jobs; `--overlay <dir>` overrides it.
# Default: ~/Library/Application Support/Gambitik/voice-overlay
# VOICE_OVERLAY_DIR="/Users/<you>/Library/Application Support/Gambitik/voice-overlay"
