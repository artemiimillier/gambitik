# Deploy kit settings — copy to deploy/docker-ssh/deploy.env (git-ignored) and fill in.
# Plain KEY=value lines; a variable set in the environment wins over this file.
# Another file: GAMBIT_DEPLOY_ENV=/path/to/file deploy/docker-ssh/deploy.sh

# REQUIRED — an ssh alias from ~/.ssh/config that logs in as root (or a docker-capable user) with a key, no password prompt
GAMBIT_SSH_HOST=my-vps

# REQUIRED for deploy.sh — the public host name Traefik routes to the container (DNS must point at the server)
GAMBIT_HOST=kids.example.com

# Where the compose project lives on the server (docker-compose.yml, .env, app.env, overlay/, sources)
GAMBIT_REMOTE_DIR=/docker/gambitik

# Where backup.sh (run on the server by cron) keeps its nightly archives; pull-backups.sh copies them from here
GAMBIT_REMOTE_BACKUP_DIR=/root/backups/gambitik

# The families' clock (game file names, journal dates). Written to the server's .env on the first deploy only.
GAMBIT_TZ=UTC

# Local copy of the server backups (pull-backups.sh); default ~/Library/Application Support/Gambitik/server-backups
# GAMBIT_BACKUP_DIR=

# Label of the macOS LaunchAgent that runs pull-backups.sh every morning (pull-backups-agent.sh install)
GAMBIT_PULL_BACKUPS_LABEL=org.gambitik.pull-backups

# Optional: the Node base image of the build (default node:26-bookworm-slim)
# GAMBIT_NODE_IMAGE=node:26-bookworm-slim
